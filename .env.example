# Supabase project URL (Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous public key (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings > API Keys).
# Server only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the Vercel cron job hitting /api/cron/daily-scan.
# Set the same value in Vercel > Project Settings > Environment Variables.
CRON_SECRET=

# Free SAM.gov API key (SAM.gov account > Account Details).
# Without it, SAM.gov returns 404 and every scan finds nothing.
# Get one free, then set it in Vercel > Project Settings > Environment Variables.
SAM_API_KEY=

# Stripe billing (Pro tier). Server only. Never expose to the browser
# or commit a real value. Use test keys while testing, live keys at go-live.
STRIPE_SECRET_KEY=

# Price ids for the Pro tier. Create two recurring prices in the Stripe
# dashboard (Products): Pro Monthly, $24/month recurring; Pro Annual,
# $240/year recurring. Paste each price id (price_...) here.
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=

# Webhook signing secret for POST /api/billing/webhook.
# Stripe Dashboard > Developers > Webhooks > Add endpoint, then copy
# the signing secret (whsec_...). The endpoint must listen for
# checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=

# Public app URL, used for Stripe Checkout return links.
# Defaults to the production URL when unset.
NEXT_PUBLIC_APP_URL=https://contract-hub-mu.vercel.app
